{
  "hosting": {
    "public": "site",
    "cleanUrls": false,
    "trailingSlash": false,
    "ignore": ["**/.*", "**/LISEZ-MOI.txt"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'" }
        ]
      },
      {
        "source": "admin/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "**/*.@(svg|png|jpg|jpeg|webp)",
        "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ]
      }
    ]
  }
}
